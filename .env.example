# ==============================================================================
# MD FOYSAL AL NUR - Portfolio Environment Configuration
# Template variables for production deployment & cloud database integration
# NOTE: Never commit sensitive API secrets to public version control.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
SITE_URL=https://foysalalnur.com

# Master Administrator Credentials (Server-side hash)
ADMIN_EMAIL=faysalnur416@gmail.com
ADMIN_MASTER_PASSKEY_HASH=foysal2026_argon2_or_bcrypt_hash

# Firebase Configuration (Optional Cloud Persistence)
# Obtain these from your Firebase Console -> Project Settings -> General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=foysal-portfolio.firebaseapp.com
FIREBASE_PROJECT_ID=foysal-portfolio
FIREBASE_STORAGE_BUCKET=foysal-portfolio.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Supabase Configuration (Alternative PostgreSQL Backend)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# SMS Gateway Configuration (Legitimate Provider Webhook)
# Compatible with Greenweb SMS / BulkSMS BD / Twilio
SMS_GATEWAY_PROVIDER=greenweb
SMS_GATEWAY_ENDPOINT=https://api.sms-gateway.com/v3/send
SMS_SENDER_ID=FOYSALNUR
SMS_API_KEY=your_live_sms_gateway_api_token
SMS_RECIPIENT_FALLBACK=+8801855669424

# Contact Form Email Dispatch (e.g. Resend / SendGrid / Nodemailer)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
CONTACT_INBOX_EMAIL=faysalnur416@gmail.com
